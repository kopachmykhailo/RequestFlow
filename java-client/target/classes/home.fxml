<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ua.requestflow.MainController"
            styleClass="page">

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="navbar">

            <Label text="RequestFlow"
                   styleClass="logo-small"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Головна"
                    onAction="#openHome"
                    styleClass="nav-button"/>

            <Button text="Мої заявки"
                    onAction="#openApplications"
                    styleClass="nav-button"/>

            <Button text="Створити заявку"
                    onAction="#openCreateApplication"
                    styleClass="primary-button"/>

            <Button text="Вийти"
                    onAction="#openLogin"
                    styleClass="nav-button"/>

        </HBox>

    </top>

    <center>

        <VBox alignment="CENTER"
                spacing="20"
                styleClass="home-content">

            <Label fx:id="welcomeLabel"
                   text="Вітаємо у RequestFlow!"
                   styleClass="big-title"/>

            <Label text="Система автоматизації реєстрації та обробки заявок"
                   styleClass="description"/>

            <HBox alignment="CENTER"
                  spacing="20">

                <VBox alignment="CENTER"
                      spacing="8"
                      styleClass="stat-card">

                    <Label fx:id="totalApplicationsLabel"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="Мої заявки"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="8"
                      styleClass="stat-card">

                    <Label fx:id="processingApplicationsLabel"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="В обробці"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="8"
                      styleClass="stat-card">

                    <Label fx:id="resolvedApplicationsLabel"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="Вирішено"/>

                </VBox>

            </HBox>

            <Button text="Створити нову заявку"
                    onAction="#openCreateApplication"
                    prefWidth="240"
                    prefHeight="45"
                    styleClass="primary-button"/>

        </VBox>

    </center>

</BorderPane>